{
  "name": "@selfconnect/tsk-client",
  "version": "1.0.0",
  "description": "SelfConnect TSK (Token Safety Key) client — govern any AI agent in 3 lines of code",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest tests/",
    "test:live": "TSK_LIVE=1 node --experimental-vm-modules node_modules/.bin/jest tests/",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ai", "agent", "governance", "tsk", "selfconnect",
    "budget", "safety", "compliance", "eu-ai-act"
  ],
  "author": "SelfConnect.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rblake2320/selfconnect-ecosystem.git",
    "directory": "packages/tsk-client"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
