{
  "name": "@selfconnect/tsk-mcp",
  "version": "1.0.0",
  "description": "MCP server for SelfConnect TSK (Trust Session Key) \u2014 AI agent governance tools for Claude, Cursor, and MCP-compatible agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "selfconnect-tsk-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "dev": "tsx src/index.ts",
    "pretest": "pnpm --filter @selfconnect/tsk-client build",
    "test": "node ./node_modules/jest/bin/jest.js --testPathPattern=tests/"
  },
  "keywords": [
    "mcp",
    "selfconnect",
    "tsk",
    "ai-governance",
    "llm",
    "agent"
  ],
  "author": "SelfConnect <hello@selfconnect.ai>",
  "license": "MIT",
  "dependencies": {
    "@selfconnect/tsk-client": "file:../tsk-client"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
